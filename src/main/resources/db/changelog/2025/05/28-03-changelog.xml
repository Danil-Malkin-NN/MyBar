<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1748441273269-3" author="dvmalkin">
        <addColumn tableName="ingredient">
            <column name="image_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="1748441273269-4" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="ingredient"
                                 constraintName="FK_INGREDIENT_ON_IMAGE" referencedColumnNames="id"
                                 referencedTableName="image"/>
    </changeSet>

    <changeSet id="1748441273269-2" author="dvmalkin">
        <addColumn tableName="ingredient">
            <column autoIncrement="true" incrementBy="1" name="id" startWith="1" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ingredient" validateNullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>