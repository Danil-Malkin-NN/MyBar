<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1748504082769-1" author="dvmalkin">
        <createTable tableName="cocktail">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cocktail"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="volume" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="strength" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-2" author="dvmalkin">
        <createTable tableName="cocktail_ingredients">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ingredients_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-3" author="dvmalkin">
        <createTable tableName="cocktail_instruments">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="instruments_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-4" author="dvmalkin">
        <createTable tableName="cocktail_steps">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="steps_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-5" author="dvmalkin">
        <createTable tableName="image">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_image"/>
            </column>
            <column name="image_path" type="TEXT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-6" author="dvmalkin">
        <createTable tableName="ingredient">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ingredient"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-7" author="dvmalkin">
        <createTable tableName="ingredient_and_count">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ingredientandcount"/>
            </column>
            <column name="ingredient_id" type="BIGINT"/>
            <column name="count" type="INT"/>
            <column name="unit_type" type="SMALLINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-8" author="dvmalkin">
        <createTable tableName="instrument">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_instrument"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-9" author="dvmalkin">
        <createTable tableName="step">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_step"/>
            </column>
            <column name="goal" type="TEXT"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-10" author="dvmalkin">
        <createTable tableName="step_instruments">
            <column name="step_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="instruments_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-11" author="dvmalkin">
        <createTable tableName="step_uses_ingredients">
            <column name="step_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="uses_ingredients_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-12" author="dvmalkin">
        <createTable tableName="user">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-13" author="dvmalkin">
        <createTable tableName="user_favorite_cocktail">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_favoritecocktail"/>
            </column>
            <column name="favorite_cocktail_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_favoritecocktail"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-14" author="dvmalkin">
        <createTable tableName="user_ingredient">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_ingredient"/>
            </column>
            <column name="ingredient_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_ingredient"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748504082769-15" author="dvmalkin">
        <addUniqueConstraint columnNames="name" constraintName="uc_ingredient_name" tableName="ingredient"/>
    </changeSet>
    <changeSet id="1748504082769-16" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="cocktail"
                                 constraintName="FK_COCKTAIL_ON_IMAGE" referencedColumnNames="id"
                                 referencedTableName="image"/>
    </changeSet>
    <changeSet id="1748504082769-17" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="ingredient_id" baseTableName="ingredient_and_count"
                                 constraintName="FK_INGREDIENTANDCOUNT_ON_INGREDIENT" referencedColumnNames="id"
                                 referencedTableName="ingredient"/>
    </changeSet>
    <changeSet id="1748504082769-18" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="ingredient"
