                                 constraintName="fk_cocste_on_cocktail" referencedColumnNames="id"
                                 referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748504082769-26" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="steps_id" baseTableName="cocktail_steps"
                                 constraintName="fk_cocste_on_step" referencedColumnNames="id"
                                 referencedTableName="step"/>
    </changeSet>
    <changeSet id="1748504082769-27" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="instruments_id" baseTableName="step_instruments"
