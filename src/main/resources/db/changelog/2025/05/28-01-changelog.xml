<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1748436657105-1" author="dvmalkin">
        <createTable schemaName="keycloak" tableName="user_entity" ifNotExists="true">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1748436657105-2" author="dvmalkin">
        <createTable schemaName="postgres" tableName="user_entity_favorite_cocktail" ifNotExists="true">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_favoritecocktail"/>
            </column>
            <column name="favorite_cocktail_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_favoritecocktail"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748436657105-3" author="dvmalkin">
        <createTable schemaName="postgres" tableName="user_entity_ingredient" ifNotExists="true">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_ingredient"/>
            </column>
            <column name="ingredient_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_ingredient"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748436657105-4" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="favorite_cocktail_id" baseTableName="user_entity_favorite_cocktail"
                                 baseTableSchemaName="postgres" constraintName="fk_useentfavcoc_on_cocktail"
                                 referencedColumnNames="id" referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748436657105-5" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_entity_favorite_cocktail"
                                 baseTableSchemaName="postgres" constraintName="fk_useentfavcoc_on_user"
                                 referencedColumnNames="id" referencedTableName="user_entity"
                                 referencedTableSchemaName="keycloak"/>
    </changeSet>
    <changeSet id="1748436657105-6" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="ingredient_id" baseTableName="user_entity_ingredient"
                                 baseTableSchemaName="postgres" constraintName="fk_useenting_on_ingredient"
                                 referencedColumnNames="id" referencedTableName="ingredient"
                                 referencedTableSchemaName="postgres"/>
    </changeSet>
    <changeSet id="1748436657105-7" author="dvmalkin">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_entity_ingredient"
                                 baseTableSchemaName="postgres" constraintName="fk_useenting_on_user"
                                 referencedColumnNames="id" referencedTableName="user_entity"
                                 referencedTableSchemaName="keycloak"/>
    </changeSet>

</databaseChangeLog>