<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1748452045381-1" author="Danil">
        <createTable tableName="cocktail">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cocktail"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="volume" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="strength" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-2" author="Danil">
        <createTable tableName="cocktail_ingredients">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ingredients_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-3" author="Danil">
        <createTable tableName="cocktail_instruments">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="instruments_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-4" author="Danil">
        <createTable tableName="cocktail_steps">
            <column name="cocktail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="steps_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-5" author="Danil">
        <createTable tableName="image">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_image"/>
            </column>
            <column name="image_path" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-6" author="Danil">
        <createTable tableName="ingredient">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ingredient"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-7" author="Danil">
        <createTable tableName="ingredient_and_count">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_ingredientandcount"/>
            </column>
            <column name="ingredient_id" type="BIGINT"/>
            <column name="count" type="INT"/>
            <column name="unit_type" type="SMALLINT"/>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-8" author="Danil">
        <createTable tableName="instrument">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_instrument"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-9" author="Danil">
        <createTable tableName="step">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_step"/>
            </column>
            <column name="goal" type="TEXT"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-10" author="Danil">
        <createTable tableName="step_instruments">
            <column name="step_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="instruments_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1748452045381-11" author="Danil">
        <createTable tableName="step_uses_ingredients">
            <column name="step_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="uses_ingredients_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748452045381-12" author="Danil">
        <addUniqueConstraint columnNames="name" constraintName="uc_ingredient_name" tableName="ingredient"/>
    </changeSet>
    <changeSet id="1748452045381-13" author="Danil">
        <addForeignKeyConstraint baseColumnNames="ingredient_id" baseTableName="ingredient_and_count"
                                 constraintName="FK_INGREDIENTANDCOUNT_ON_INGREDIENT" referencedColumnNames="id"
                                 referencedTableName="ingredient"/>
    </changeSet>
    <changeSet id="1748452045381-14" author="Danil">
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="ingredient"
                                 constraintName="FK_INGREDIENT_ON_IMAGE" referencedColumnNames="id"
                                 referencedTableName="image"/>
    </changeSet>
    <changeSet id="1748452045381-15" author="Danil">
        <addForeignKeyConstraint baseColumnNames="cocktail_id" baseTableName="cocktail_ingredients"
                                 constraintName="fk_cocing_on_cocktail" referencedColumnNames="id"
                                 referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748452045381-16" author="Danil">
        <addForeignKeyConstraint baseColumnNames="ingredients_id" baseTableName="cocktail_ingredients"
                                 constraintName="fk_cocing_on_ingredient_and_count" referencedColumnNames="id"
                                 referencedTableName="ingredient_and_count"/>
    </changeSet>
    <changeSet id="1748452045381-17" author="Danil">
        <addForeignKeyConstraint baseColumnNames="cocktail_id" baseTableName="cocktail_instruments"
                                 constraintName="fk_cocins_on_cocktail" referencedColumnNames="id"
                                 referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748452045381-18" author="Danil">
        <addForeignKeyConstraint baseColumnNames="instruments_id" baseTableName="cocktail_instruments"
                                 constraintName="fk_cocins_on_instrument" referencedColumnNames="id"
                                 referencedTableName="instrument"/>
    </changeSet>
    <changeSet id="1748452045381-19" author="Danil">
        <addForeignKeyConstraint baseColumnNames="cocktail_id" baseTableName="cocktail_steps"
                                 constraintName="fk_cocste_on_cocktail" referencedColumnNames="id"
                                 referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748452045381-20" author="Danil">
        <addForeignKeyConstraint baseColumnNames="steps_id" baseTableName="cocktail_steps"
                                 constraintName="fk_cocste_on_step" referencedColumnNames="id"
                                 referencedTableName="step"/>
    </changeSet>
    <changeSet id="1748452045381-21" author="Danil">
        <addForeignKeyConstraint baseColumnNames="instruments_id" baseTableName="step_instruments"
                                 constraintName="fk_steins_on_instrument" referencedColumnNames="id"
                                 referencedTableName="instrument"/>
    </changeSet>
    <changeSet id="1748452045381-22" author="Danil">
        <addForeignKeyConstraint baseColumnNames="step_id" baseTableName="step_instruments"
                                 constraintName="fk_steins_on_step" referencedColumnNames="id"
                                 referencedTableName="step"/>
    </changeSet>
    <changeSet id="1748452045381-23" author="Danil">
        <addForeignKeyConstraint baseColumnNames="uses_ingredients_id" baseTableName="step_uses_ingredients"
                                 constraintName="fk_steuseing_on_ingredient_and_count" referencedColumnNames="id"
                                 referencedTableName="ingredient_and_count"/>
    </changeSet>
    <changeSet id="1748452045381-24" author="Danil">
        <addForeignKeyConstraint baseColumnNames="step_id" baseTableName="step_uses_ingredients"
                                 constraintName="fk_steuseing_on_step" referencedColumnNames="id"
                                 referencedTableName="step"/>
    </changeSet>
    <changeSet id="1748452045597-1" author="Danil">
        <createTable schemaName="keycloak" tableName="user_entity" ifNotExists="true">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1748452045597-2" author="Danil">
        <createTable schemaName="postgres" tableName="user_entity_favorite_cocktail">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_favoritecocktail"/>
            </column>
            <column name="favorite_cocktail_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_favoritecocktail"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748452045597-3" author="Danil">
        <createTable schemaName="postgres" tableName="user_entity_ingredient">
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_ingredient"/>
            </column>
            <column name="ingredient_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_entity_ingredient"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1748452045597-4" author="Danil">
        <addForeignKeyConstraint baseColumnNames="favorite_cocktail_id" baseTableName="user_entity_favorite_cocktail"
                                 baseTableSchemaName="postgres" constraintName="fk_useentfavcoc_on_cocktail"
                                 referencedColumnNames="id" referencedTableName="cocktail"/>
    </changeSet>
    <changeSet id="1748452045597-5" author="Danil">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_entity_favorite_cocktail"
                                 baseTableSchemaName="postgres" constraintName="fk_useentfavcoc_on_user"
                                 referencedColumnNames="id" referencedTableName="user_entity"
                                 referencedTableSchemaName="keycloak"/>
    </changeSet>
    <changeSet id="1748452045597-6" author="Danil">
        <addForeignKeyConstraint baseColumnNames="ingredient_id" baseTableName="user_entity_ingredient"
                                 baseTableSchemaName="postgres" constraintName="fk_useenting_on_ingredient"
                                 referencedColumnNames="id" referencedTableName="ingredient"/>
    </changeSet>
    <changeSet id="1748452045597-7" author="Danil">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_entity_ingredient"
                                 baseTableSchemaName="postgres" constraintName="fk_useenting_on_user"
                                 referencedColumnNames="id" referencedTableName="user_entity"
                                 referencedTableSchemaName="keycloak"/>
    </changeSet>

</databaseChangeLog>